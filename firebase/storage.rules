rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signed(){return request.auth!=null && request.auth.token.email_verified==true;}
  function memberExists(){return signed() && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid));}
  function memberData(){return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data;}
  function baseActive(){return memberExists() && memberData().active==true;}
  function baseTeacher(){return baseActive() && memberData().role=='teacher';}
  function baseStaff(){return baseActive() && memberData().role in ['teacher','editor'];}
  function openAdmin(){return signed() && (!firestore.exists(/databases/(default)/documents/settings/access) || firestore.get(/databases/(default)/documents/settings/access).data.openAdmin==true);}
  function active(){return signed() && (openAdmin() || baseActive());}
  function staff(){return signed() && (openAdmin() || baseStaff());}
  function teacher(){return signed() && (openAdmin() || baseTeacher());}
  function article(id){return firestore.get(/databases/(default)/documents/articles/$(id)).data;}
  function permitted(id){return active() && (staff() || request.auth.uid in article(id).assigneeIds);}
  function photo(){return request.resource.size>0 && request.resource.size<=25*1024*1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');}
  match /private/{aid}/{mediaId}/{filename} {
   allow read: if permitted(aid);
   allow create: if resource == null && permitted(aid) && article(aid).status in ['draft','changes'] && photo() && filename in ['original','web.webp'];
   allow update,delete: if false;
  }
  match /public/{aid}/{revision}/{filename} {
   allow read: if teacher() || (firestore.exists(/databases/(default)/documents/publications/$(aid)) &&
    string(firestore.get(/databases/(default)/documents/publications/$(aid)).data.sourceRevision)==revision);
   allow create: if resource == null && teacher() && photo() && request.resource.contentType=='image/webp' &&
    !(firestore.exists(/databases/(default)/documents/publications/$(aid)) &&
      string(firestore.get(/databases/(default)/documents/publications/$(aid)).data.sourceRevision)==revision);
   allow update,delete: if false;
  }
  match /{all=**}{allow read,write: if false;}
 }
}
