PORT=8787
MCP_PATH=/mcp
HOST=127.0.0.1

# Start narrow. Add only project folders you want MCP clients to access.
WORKSPACE_ROOT=C:\\Users\\YOUR_NAME\\projects

# read | write | control
PERMISSION_PROFILE=read

# Privileged profiles must still require authorization.
OAUTH_TOKEN_TTL_SECONDS=3600

# Never commit real secrets.
LOCAL_APPROVAL_REQUIRED=1
AUDIT_LOG=.khs-mcp/audit.jsonl
