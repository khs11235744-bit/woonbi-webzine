PORT=8787
MCP_PATH=/mcp
HOST=127.0.0.1

# Keep this as narrow as possible.
WORKSPACE_ROOT=C:\\Users\\YOUR_NAME\\projects

# read | write | control
PERMISSION_PROFILE=read

# Generate with bootstrap.ps1. Never commit the real value.
LOCAL_CONTROL_TOKEN=change-me-to-a-long-random-value

MAX_READ_BYTES=262144
MAX_DIRECTORY_ENTRIES=300
COMMAND_TIMEOUT_MS=15000

SAFE_EXECUTABLES=git,git.exe,node,node.exe,npm,npm.cmd,npx,npx.cmd,python,python.exe,python3,python3.exe,rg,rg.exe,where,where.exe,ipconfig,tasklist,whoami,hostname
