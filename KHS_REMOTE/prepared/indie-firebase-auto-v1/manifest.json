{
  "bundle": "indie-firebase-auto-v1",
  "project": "INDI+P",
  "description": "Firebase scheduled Dtryx + news sync, last-good preservation, public health endpoint",
  "files": [
    {"source":"functions/index.js","target":"functions/index.js"},
    {"source":"functions/package.json","target":"functions/package.json"},
    {"source":"functions/.gitignore","target":"functions/.gitignore"},
    {"source":"firebase.json","target":"firebase.json"}
  ],
  "deploy": {
    "projectId":"indieplus-pohang-khs",
    "only":"firestore:rules,functions,hosting"
  },
  "schedules": {
    "syncDtryxSchedule":"every 30 minutes",
    "syncNewsSchedule":"every 3 hours"
  },
  "safety": {
    "lastGoodPreserved":true,
    "statusDoc":"public/automationStatus",
    "healthFunction":"syncHealth"
  }
}
